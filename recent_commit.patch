+def read_csv_from_s3(s3_client: Any, bucket: str, key: str) -> Any:
+    try:
+        obj = s3_client.get_object(Bucket=bucket, Key=key)
+        import pandas as pd
+
+        return pd.read_csv(obj["Body"])
+    except Exception as exc:
+        print(f"Error reading {key} from {bucket}: {exc}")
+        sys.exit(1)
