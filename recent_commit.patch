+                    "Timestamp": pd.Timestamp("2026-05-01T00:00:00"),
+                    "Namespace": "AWS/ElastiCache",
+                    "MetricName": "CacheHitRate",
+                    "Stat": "Average",
+                    "Value": 65.0,
+                    "Unit": "Percent",
+                    "Dimensions": "CacheClusterId=cluster-a",
